# WeatherGPT Configuration (SIH26068)
PROJECT_NAME="WeatherGPT"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"
DEBUG=True

# Optional: Google Gemini API Key for rich multi-turn natural language synthesis
# If not provided, WeatherGPT runs with its built-in offline meteorological NLU engine.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS origins (comma separated or * for local development)
ALLOWED_ORIGINS="*"

# Cache Duration in seconds
CACHE_TTL_SECONDS=900
